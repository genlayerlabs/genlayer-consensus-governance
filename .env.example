# Public, versioned deployment configuration. Never put private keys here.
VITE_CHAIN_ID=4221
VITE_CHAIN_NAME=GenLayer Testnet
VITE_RPC_URL=https://rpc-genlayer-chain-testnet-cfn8m3xc6l.t.conduit.xyz
VITE_EXPLORER_URL=https://explorer-genlayer-chain-testnet-cfn8m3xc6l.t.conduit.xyz

# The AddressManager the app falls back to when a visitor has not chosen one.
# A user's own choice lives in localStorage and always wins; that local
# preference contains no governance data. Blank here starts the app on an empty
# "select a deployment" state.
# Code default: the Orbit testnet deployment (sealed, with the nine governance
# identities). Since the CON-865 cut the app resolves those identities by key
# from a sealed AddressManager.
VITE_ADDRESS_MANAGER=0xF44832E41c8c29844cB84Be264dc883Fc129cd14

# Floor for historical log scans. 0 is always CORRECT but slow — the scanners
# page backwards from the head, so this mainly stops them walking to genesis.
# The block a deployment's AddressManager was created in is the right value
# (a few hundred blocks on the Orbit testnet deployment). Keep 0 if the AddressManager is switched at
# runtime: a floor above another deployment's history would silently hide it.
VITE_DEPLOYMENT_START_BLOCK=0
